# ─────────────────────────────────────────────────────────────
# Raumvia – Umgebungsvariablen (Vorlage). NIE echte Werte committen.
# Lokal: als .env.local kopieren. Produktion: Vercel › Settings › Environment Variables
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (ohne Schrägstrich am Ende)
APP_URL=http://localhost:3000

# PostgreSQL. Supabase: Session-Pooler (Port 5432) mit ?sslmode=require – NICHT den Transaction-Pooler (6543): Auf Vercel blieben damit parallele Abfragen hängen.
DATABASE_URL=postgres://raumpilot:raumpilot@localhost:5432/raumpilot_dev
DATABASE_POOL_MAX=5

# Geheimnisse – erzeugen mit: openssl rand -base64 48  (APP_SECRET, CRON_SECRET)
#                             openssl rand -base64 32  (ENCRYPTION_KEY, genau 32 Byte)
APP_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Zahlungen: disabled | stripe | fake (fake NUR für automatisierte Tests, in Produktion gesperrt)
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
# Webhook-Endpunkt https://<domain>/api/webhooks/stripe  (Ereignisse des Plattform-Kontos)
STRIPE_WEBHOOK_SECRET=
# Webhook-Endpunkt https://<domain>/api/webhooks/stripe-connect  («Ereignisse auf verbundenen Konten»)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optionale Plattformgebühr auf Buchungen in Basispunkten (100 = 1 %). Standard 0.
PLATFORM_FEE_BPS=0
TRIAL_DAYS=14

# E-Mail: log (nur protokollieren) | resend
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM="Raumvia <info@raumvia.ch>"
EMAIL_REPLY_TO=info@raumvia.ch
ADMIN_ALERT_EMAIL=

# Dateien: local | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Optional: Cloudflare Turnstile (Bot-Schutz) und Sentry (Fehlerüberwachung)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
